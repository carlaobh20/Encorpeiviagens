# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local NUNCA deve ser commitado (já está no .gitignore).

# ── Supabase ─────────────────────────────────────────────
# Painel Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# APENAS no servidor / worker. NUNCA expor no front. Bypassa RLS.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── App ──────────────────────────────────────────────────
# URL pública do app (usada no link de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── IA (Gemini) ──────────────────────────────────────────
# Pegue em https://aistudio.google.com/apikey (tem plano grátis)
# Usada na tela de Nova rota para preencher os campos por texto livre.
GEMINI_API_KEY=AIzaSy...

# ── Provider de busca ────────────────────────────────────
# Qual provider o app/worker usa pra buscar voos em pontos.
# mock       = sempre funciona, dados simulados (default)
# latam_web  = Playwright direto no site da LATAM (rodar fora da Vercel)
# manual     = não busca, espera entrada manual
AWARD_PROVIDER=mock

# Configuração do LATAM provider (só usado quando AWARD_PROVIDER=latam_web)
LATAM_HEADLESS=true
LATAM_DEBUG=false
LATAM_TIMEOUT_MS=45000

# ── Worker (opcional) ────────────────────────────────────
# Segredo para autenticar chamadas em POST /api/worker/run
# (Vercel Cron, EasyCron, GitHub Actions, etc.)
# WORKER_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Criptografia da sessão LATAM (futuro/fase 2) ─────────
# ENCRYPTION_SECRET=
